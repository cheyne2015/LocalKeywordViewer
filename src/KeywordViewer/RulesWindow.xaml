<Window x:Class="KeywordViewer.RulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="关键词规则" Width="620" Height="680" MinWidth="540" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="自动总结的展示规则" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="保存后立即更新排行；放宽规则可恢复被规则排除的词，无需重新扫描。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#62718A"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
   <TextBlock Text="至少资料组数" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="MinimumGroupsBox" Grid.Column="1" AutomationProperties.Name="至少资料组数"/>
   <TextBlock Text="词长" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="MinimumLengthBox" Grid.Column="3" AutomationProperties.Name="最短词长"/><TextBlock Text="～" Grid.Column="4" VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="MaximumLengthBox" Grid.Column="5" AutomationProperties.Name="最长词长"/>
  </Grid>
  <CheckBox x:Name="ChineseOnlyBox" Grid.Row="2" Content="仅显示中文关键词（关闭后保留英文名称）" Margin="0,0,0,12"/>
  <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="屏蔽词：完全相同才排除，一行一个" Margin="0,0,0,6"/><TextBox Grid.Row="1" x:Name="ExcludedWordsBox" AutomationProperties.Name="完全匹配屏蔽词" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
  <Grid Grid.Row="4" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="包含排除：关键词含以下任意片段就排除，一行一个" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox Grid.Row="1" x:Name="ExcludedContainsBox" AutomationProperties.Name="包含文字排除规则" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
  <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#B62932" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <DockPanel Grid.Row="6"><Button Content="恢复适中默认规则" Click="Defaults_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button Content="保存规则" IsDefault="True" Click="Save_Click" Background="#245CC9" Foreground="White"/></StackPanel></DockPanel>
 </Grid>
</Window>
